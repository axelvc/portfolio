---
import Layout from '../layouts/Layout.astro'
import IconGithub from '../components/icons/github.svg'
import client from '../services/notion'

const data = await client.getWorkData()
---
<Layout>
  <main class="mt-20">
    <h1 class="text-4xl font-bold tracking-wider">/Work</h1>

    <section class="mt-16 mb-40 grid grid-cols-1 sm:grid-cols-2 gap-8">
      {
        data.map(project => (
          <article class="py-8 px-4 flex justify-between gap-8 items-center relative group">
            <a
              href={project.link}
              rel="noopener noreferrer"
              target="_blank"
              class="no-underline absolute inset-0 transition-colors border-b border-b-base-800 group-hover:border-b-base-200"
            />

            <div>
              <h3 class="text-xl font-bold">{project.title}</h3>
              <p class="text-sm text-base-400">{project.description}</p>
            </div>

            {project.code && (
              <a
                href={project.code}
                rel="noopener noreferrer"
                target="_blank"
                class="shrink-0 no-underline h-10 w-10 grid place-items-center transition-colors relative group/code hover:text-base-900"
              >
                <IconGithub class="z-1 w-6 h-6" />
                <div class="absolute inset-0 bg-base-200 transition-transform scale-y-0 group-hover/code:scale-y-100" />
              </a>
            )}
          </article>
        ))
      }
    </section>
  </main>
</Layout>
